  "findingsResolved": [
    {
      "finding": "Live clock injection and phase re-entry could weaken a fixed window.",
      "resolution": "Live clocks are fixed; started records are one-shot and cannot resume. Deadline, STOP and backward-clock regressions pass."
    },
    {
      "finding": "Ledger and predecessor proof binding needed to be explicit.",
      "resolution": "Mode, sample, derived authorization hashes, summary and ledger hashes bind each phase. The actual gate proof is recorded in business summary."
    },
    {
      "finding": "Native errors needed arrival records and scheduled revision route compatibility.",
      "resolution": "Received/response/exception records bind native IPC to the requested task, journal event, snapshot/export and cold restart. Live paths never synthesize user actions."
    },
    {
      "finding": "Asynchronous admission could complete after a phase deadline.",
      "resolution": "The shared admission module rechecks identity and deadline/STOP after all asynchronous phase and binding reads, before broker admission."
    },
    {
      "finding": "Forwarding modules left actual proof helpers outside the new seal.",
      "resolution": "Actual citation-offline proof implementations and evidence helpers are sealed with the runner."
    },
    {
      "finding": "Old population metadata could misstate two-case quality statistics.",
      "resolution": "Plan metadata and dedicated report use two generated workflows and zero fixed-invalid controls. Terminal semantic rules are reused; null denominators and synthetic quality null are preserved."
    }
