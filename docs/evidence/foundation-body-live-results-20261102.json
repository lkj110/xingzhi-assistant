  "cause": {
    "factualContent": "两段业务正文事实正确，且新稿使用新的核验 basis。",
    "contract": "标题放在 title 字段，content 仅放正文；修订 originalContent 时同样不要加入重复标题。明确要求的自然段以空行分隔。",
    "actual": "content 仍以与独立 title 相同的 Markdown 标题开头，之后是两段业务正文。",
    "mechanism": [
      "初稿无当前两段规则，content 中的标题沿用至修订原文。",
      "修订模型返回 patch，仅替换业务段落，留下原 content 标题。",
      "本地段落检查对 Markdown 布局返回 unsupported/non-prose-layout，未产生结构阻断。",
      "语义核验仍判通过；独立检查拒绝后执行器正确停止。"
    ],
    "notClaimed": "不将 Markdown 标题称为第三个自然段，不将本次格式契约错误计为业务事实幻觉。"
  },
  "preservation": {
    "candidateInstalled": false,
    "installationWritesByThisTask": 0,
    "F04Executions": 0,
    "extraModelProbes": 0,
    "sourceEditsDuringLive": 0,
    "installedDirectoryContinuouslyFrozen": false,
    "installationProvenance": "此前安装目录存在多次来源未定变化，用户表示未主动更新/不确定。本任务未安装或覆盖；末次观察另附独立复核记录，不能证明连续冻结。"
  },
  "limitations": [
    "沿用已暴露封存样本，F05历史回放参与修复；不是全新盲样或随机对照。",
    "质量指标分母仅包含两份实际可判定稿件；不推断总体质量或成本改善。",
    "G01通过不能替代F05修订、真人确认重检、最终验收或F06重启流程通过。",
    "原始失败摘要的pending-independent-final-audit字段保留，最终独立裁定单独绑定，不改写原始证据。"
  ],
  "nextStep": {
    "proposedOnly": true,
    "realModelCallsAuthorized": false,
    "scope": "先离线补齐本次已明确的 title/content 契约检查。",
    "items": [
      "用本次真实初稿、修订patch及最终稿重放，定位重复标题保留路径。",
      "仅对适用规则下与独立title完全一致的起首重复标题做确定性拒绝，覆盖Markdown形式；不自动删改正文，不扩展泛化语义。",
      "补充生成/patch合并/核验/验收/冷重启的同一稿件回归与反例，经独立审核后再封存候选。",
      "离线证据齐备后提出未完成环节的最小真实复测方案与新预算，当前轮不续跑。"
    ]
  },
