  "findings": [
    {
      "id": "R7-IR-01",
      "severity": "P2",
      "status": "fixed_and_reverified",
      "title": "Retired goals and legacy wrapped directives re-entered production requirement surfaces",
      "initialLocations": [
        "desktop/work-obligations.cjs:5",
        "desktop/requirements.cjs:13"
      ],
      "failure": "After a trusted Q1 to Q2 task edit, executionControl.requirements and content-check requirements still supplied the old job goal and duplicate wrapped feedback.",
      "fix": "Both production requirement surfaces now share execution-contract/requirement-projection output, while current task objectives remain supplied.",
      "regressions": [
        "retired goal and wrapped directives stay retired in production planner requirement surfaces",
        "retired goal and wrapped directives stay retired in production content_check requirement surfaces"
      ]
    },
    {
      "id": "R7-IR-02",
      "severity": "P2",
      "status": "fixed_and_reverified",
      "title": "A later committed user supplement disappeared when its wall-clock timestamp equalled the contract timestamp",
      "initialLocations": [
        "desktop/requirement-projection.cjs:11",
        "desktop/grounding.cjs:27"
      ],
      "failure": "A frozen-clock agentContract followed by taskAction feedback produced a later workSequence, but timestamp-only filtering removed the new supplement.",
      "fix": "Contract filtering and event ordering prefer trusted workSequence; persistent directives use event identity and feedback mirrors preserve sequence.",
      "regressions": [
        "later user feedback in the same clock tick as a contract keeps journal precedence"
      ]
    },
    {
      "id": "R7-IR-03",
      "severity": "P2",
      "status": "fixed_and_reverified",
      "title": "First-line deduplication lost the precedence of the final user reassertion",
      "initialLocations": [
        "desktop/grounding.cjs:29"
      ],
      "failure": "A multiline Q1 directive, followed by Q2 and then a Q1 reassertion, left Q1 before Q2 in the flattened requirement list.",
      "fix": "Task notes and directives share event order; exact duplicate requirement lines retain their final occurrence.",
      "regressions": [
        "multiline requirement dedup retains the precedence of a later reasserted line"
      ]
    },
    {
      "id": "R7-IR-04",
      "severity": "P2",
      "status": "fixed_and_reverified",
      "title": "Projected requirement changes did not invalidate old goal gaps, and the first repair invalidated unchanged legacy gaps",
      "initialLocations": [
        "desktop/work-obligations.cjs:7"
      ],
      "failure": "A retired Q1 goal changed projected text without changing its requirement revision, leaving an old Q1 gap open. Adding text/objective to every revision then failed the existing unchanged-legacy-gap migration regression.",
      "fix": "New revisions bind projected text/objective. A one-time projectionVersion=2 compatibility refresh preserves an attributable unchanged legacy revision and gaps; a changed goal is never accepted as projection-only migration. Subsequent text/objective changes invalidate the projection.",
      "regressions": [
        "a retired goal line invalidates gaps recorded for the previous projected requirement",
        "legacy requirement gap expires when its goal is retired (migrateFirst=false)",
        "legacy requirement gap expires when its goal is retired (migrateFirst=true)",
        "legacy requirement projections refresh without invalidating unchanged gaps"
      ]
    }
  ],
