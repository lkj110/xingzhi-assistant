{
  "name": "xingzhi-assistant",
  "productName": "行知助手",
  "version": "0.42.4",
  "private": true,
  "description": "Open-source local-first desktop assistant for collecting information, advancing tasks and verifying results.",
  "main": "desktop/main.cjs",
  "author": "lkj110 and contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-selection-capture.cjs && node scripts/build-image-ocr.cjs && node scripts/build-pdf-ocr.cjs && vite build",
    "start": "npm run build && electron .",
    "preview": "node desktop/server.cjs",
    "test": "node scripts/build-image-ocr.cjs && node scripts/build-pdf-ocr.cjs && node --test tests/*.test.cjs",
    "package": "node scripts/release.cjs build",
    "test:desktop": "npm run build && node scripts/run-desktop-regression.cjs",
    "package:agent": "node scripts/release.cjs build",
    "package:audit": "node scripts/release.cjs build",
    "package:continuity": "node scripts/release.cjs build",
    "package:rules": "node scripts/release.cjs build",
    "test:subscription": "node scripts/subscription-eval.cjs",
    "package:fixes": "node scripts/release.cjs build",
    "package:projects": "node scripts/release.cjs build",
    "test:projects:subscription": "node scripts/projects-subscription-eval.cjs",
    "package:connected": "node scripts/release.cjs build",
    "test:connected:subscription": "node scripts/connected-subscription-eval.cjs",
    "package:collaboration": "node scripts/release.cjs build",
    "test:collaboration:subscription": "node scripts/collaboration-subscription-eval.cjs",
    "package:productivity": "node scripts/release.cjs build",
    "test:productivity:subscription": "node scripts/productivity-subscription-eval.cjs",
    "package:managed": "node scripts/release.cjs build",
    "test:managed:subscription": "node scripts/managed-subscription-eval.cjs",
    "package:intake": "node scripts/release.cjs build",
    "test:structured:subscription": "node scripts/structured-subscription-eval.cjs",
    "package:reliable": "node scripts/release.cjs build",
    "test:reliable:subscription": "node scripts/reliable-subscription-eval.cjs",
    "package:autonomy": "node scripts/release.cjs build",
    "test:autonomy:subscription": "node scripts/autonomy-subscription-eval.cjs",
    "package:engagement": "node scripts/release.cjs build",
    "test:engagement:subscription": "node scripts/engagement-subscription-eval.cjs",
    "package:expansion": "node scripts/release.cjs build",
    "test:expansion:subscription": "node scripts/expansion-subscription-eval.cjs",
    "package:closure": "node scripts/release.cjs build",
    "test:closure:subscription": "node scripts/closure-subscription-eval.cjs",
    "package:resilience": "node scripts/release.cjs build",
    "test:resilience:subscription": "node scripts/resilience-subscription-eval.cjs",
    "package:rhythm": "node scripts/release.cjs build",
    "test:rhythm:subscription": "node scripts/rhythm-subscription-eval.cjs",
    "package:intelligence": "node scripts/release.cjs build",
    "test:intelligence:subscription": "node scripts/intelligence-subscription-eval.cjs",
    "package:unified": "node scripts/release.cjs build",
    "test:unified:subscription": "node scripts/unified-subscription-eval.cjs",
    "package:flow": "node scripts/release.cjs build",
    "test:flow:subscription": "node scripts/flow-subscription-eval.cjs",
    "package:share": "node scripts/release.cjs build",
    "test:share": "node scripts/release.cjs verify",
    "test:collection:desktop": "npm run build && node scripts/collection-desktop-smoke.cjs",
    "test:performance": "node --test tests/workspace-view.test.cjs tests/context-operation-performance.test.cjs tests/frontend-render-performance.test.cjs",
    "test:performance:desktop": "npm run build && node scripts/performance-desktop-smoke.cjs",
    "test:models": "node --test tests/model-providers.test.cjs tests/model-fallback.test.cjs tests/model-routing.test.cjs tests/model-regression.test.cjs",
    "test:models:desktop": "npm run build && node scripts/model-providers-desktop-smoke.cjs",
    "release": "node scripts/release.cjs",
    "engineering:check": "node scripts/engineering-check.cjs",
    "iteration:metrics": "node scripts/iteration-metrics.cjs",
    "test:windows": "node scripts/windows-tests.cjs",
    "windows:package": "node scripts/windows-package.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@xmldom/xmldom": "0.9.12",
    "dingtalk-stream": "2.1.6-beta.1",
    "jszip": "3.10.2",
    "lucide-react": "0.577.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.4.5",
    "playwright": "1.63.0",
    "vite": "8.3.1"
  },
  "homepage": "https://github.com/lkj110/xingzhi-assistant",
